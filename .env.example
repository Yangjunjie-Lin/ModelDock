# Copy this file to .env. Replace every CHANGE_ME value before first start.
# Never commit .env. Values below are documentation placeholders, not defaults.

COMPOSE_PROJECT_NAME=relaydock
TZ=Asia/Shanghai
# Optional Go module proxy used only while building the backend image.
GO_MODULE_PROXY=https://proxy.golang.org,direct

# Host bindings
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PORT=8081
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=3000
CONSOLE_WEB_HOST=127.0.0.1
CONSOLE_WEB_PORT=3001
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379

# PostgreSQL
POSTGRES_DB=relaydock
POSTGRES_USER=relaydock
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_POSTGRES_PASSWORD
DATABASE_URL=postgres://relaydock:CHANGE_ME_RANDOM_POSTGRES_PASSWORD@postgres:5432/relaydock?sslmode=disable

# Redis
REDIS_PASSWORD=CHANGE_ME_RANDOM_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_RANDOM_REDIS_PASSWORD@redis:6379/0

# RelayDock secrets
# RELAYDOCK_MASTER_KEY must decode to exactly 32 random bytes (AES-256-GCM).
# Example generation: openssl rand -base64 32
RELAYDOCK_MASTER_KEY=CHANGE_ME_BASE64_32_BYTE_MASTER_KEY
# Used for HMAC hashing RelayDock client API keys.
RELAYDOCK_API_KEY_HMAC_SECRET=CHANGE_ME_RANDOM_API_KEY_HMAC_SECRET
# Used only for control-plane login sessions. Use at least 32 random bytes.
RELAYDOCK_JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET
RELAYDOCK_JWT_LIFETIME=15m
RELAYDOCK_JWT_REFRESH_LIFETIME=168h
COOKIE_SECURE=false

# Initial administrator bootstrap. There is deliberately no usable default.
# The password is hashed into PostgreSQL; changing this value later does not
# rotate an existing account. Keep runtime environment files tightly scoped.
RELAYDOCK_ADMIN_EMAIL=admin@example.invalid
RELAYDOCK_ADMIN_PASSWORD=CHANGE_ME_LONG_UNIQUE_ADMIN_PASSWORD
RELAYDOCK_ADMIN_DISPLAY_NAME=RelayDock Administrator

# Provider base URLs are control-plane records. The built-in OpenAI provider is
# seeded as https://api.openai.com/v1. Runtime Compose uses real configured
# providers only; test fixtures are never started by this stack.

# Browser origins are explicit; do not use * with authenticated endpoints.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Logging and safety
LOG_LEVEL=info
LOG_PROMPT_CONTENT=false
LOG_DIR=/app/logs
MAX_REQUEST_BODY_BYTES=10485760
CREDENTIAL_COOLDOWN=30s
SHUTDOWN_TIMEOUT=30s
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_ALLOW_PRIVATE_NETWORK=false
WEBHOOK_TIMEOUT=10s
WEBHOOK_POLL_INTERVAL=2s
WEBHOOK_MAX_ATTEMPTS=6

# Optional read-only Cockpit integration. Generate the sanitized snapshot with
# scripts/sync-cockpit.ps1. Never mount Cockpit's OAuth/account directory.
COCKPIT_SNAPSHOT_PATH=/app/cockpit/accounts.json
COCKPIT_BASE_URL=http://host.docker.internal:51900
COCKPIT_API_KEY=
COCKPIT_TEST_MODEL=gpt-5.6-luna

# Optional SDK verification variables (used by tests/sdk/python)
RELAYDOCK_BASE_URL=http://localhost:8080/v1
RELAYDOCK_API_KEY=rdk_test_replace_me
RELAYDOCK_CHAT_MODEL=gpt-default
RELAYDOCK_EMBEDDING_MODEL=embedding-default
