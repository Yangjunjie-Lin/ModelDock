# ModelDock retains RelayDock environment names for zero-downtime upgrades.
# Copy this file to .env. Replace every CHANGE_ME value before first start.
# Never commit .env. Values below are documentation placeholders, not defaults.

COMPOSE_PROJECT_NAME=relaydock
TZ=Asia/Shanghai
# Optional Go module proxy used only while building the backend image.
GO_MODULE_PROXY=https://proxy.golang.org,direct

# Host bindings
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PORT=8081
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=3000
CONSOLE_WEB_HOST=127.0.0.1
CONSOLE_WEB_PORT=3001
# Production edge scripts use this optional, RelayDock-prefixed hostname for
# the public website/console. Local Compose continues to bind CONSOLE_WEB_HOST.
RELAYDOCK_PUBLIC_SITE_DOMAIN=localhost
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
MOCK_OPENAI_PORT=8090
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093

# PostgreSQL
POSTGRES_DB=relaydock
POSTGRES_USER=relaydock
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_POSTGRES_PASSWORD
DATABASE_URL=postgres://relaydock:CHANGE_ME_RANDOM_POSTGRES_PASSWORD@postgres:5432/relaydock?sslmode=disable
# Optional DDL-only role for the external migration job.
MIGRATION_DATABASE_URL=
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_IDLE_TIME=5m
POSTGRES_MAX_CONN_LIFETIME=30m

# Redis
REDIS_PASSWORD=CHANGE_ME_RANDOM_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_RANDOM_REDIS_PASSWORD@redis:6379/0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=2
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# RelayDock secrets
# RELAYDOCK_MASTER_KEY must decode to exactly 32 random bytes (AES-256-GCM).
# Example generation: openssl rand -base64 32
RELAYDOCK_MASTER_KEY=CHANGE_ME_BASE64_32_BYTE_MASTER_KEY
# Used for HMAC hashing RelayDock client API keys.
RELAYDOCK_API_KEY_HMAC_SECRET=CHANGE_ME_RANDOM_API_KEY_HMAC_SECRET
# Used only for control-plane login sessions. Use at least 32 random bytes.
RELAYDOCK_JWT_SECRET=CHANGE_ME_RANDOM_JWT_SECRET
RELAYDOCK_JWT_LIFETIME=15m
RELAYDOCK_JWT_REFRESH_LIFETIME=168h
# During rotation, accept tokens signed with the immediately previous key;
# leave empty when no rotation is in progress.
RELAYDOCK_JWT_PREVIOUS_SECRET=
COOKIE_SECURE=false

# Account lifecycle. CLOSED permits administrator-created accounts only.
RELAYDOCK_REGISTRATION_MODE=CLOSED
RELAYDOCK_PUBLIC_CONSOLE_URL=http://127.0.0.1:3001
# Public, non-delivering placeholders. Replace them with monitored mailboxes
# before publishing the contact/support and Enterprise pages.
RELAYDOCK_PUBLIC_SUPPORT_EMAIL=support@example.invalid
RELAYDOCK_PUBLIC_ENTERPRISE_EMAIL=enterprise@example.invalid
RELAYDOCK_EMAIL_VERIFICATION_TTL=24h
RELAYDOCK_PASSWORD_RESET_TTL=1h
RELAYDOCK_INVITATION_TTL=168h
RELAYDOCK_ADMIN_MFA_REQUIRED=false
RELAYDOCK_LOGIN_RATE_LIMIT=10
RELAYDOCK_REGISTRATION_RATE_LIMIT=5
RELAYDOCK_VERIFICATION_RATE_LIMIT=10
RELAYDOCK_PASSWORD_RESET_RATE_LIMIT=5
# Per anonymous pseudonym/IP-derived limiter key for the only caller-writable
# funnel event (HOMEPAGE_VISITED). Raw identifiers are never persisted.
RELAYDOCK_PUBLIC_FUNNEL_RATE_LIMIT=120
RELAYDOCK_IDENTITY_RATE_WINDOW=15m
RELAYDOCK_CONTENT_POLICY_FAILURE_MODE=FAIL_CLOSED
RELAYDOCK_GOVERNANCE_CLEANUP_INTERVAL=1h
RELAYDOCK_REPORT_SLA_HOURS=72

# Development mail capture. Messages are encrypted in PostgreSQL and written
# to this directory only by the asynchronous outbox worker.
RELAYDOCK_MAIL_PROVIDER=local
RELAYDOCK_MAIL_FROM=ModelDock <no-reply@modeldock.local>
RELAYDOCK_MAIL_CAPTURE_DIR=/app/logs/mail
RELAYDOCK_MAIL_POLL_INTERVAL=2s
RELAYDOCK_MAIL_MAX_ATTEMPTS=6
# SMTP settings are read only when RELAYDOCK_MAIL_PROVIDER=smtp.
RELAYDOCK_SMTP_HOST=
RELAYDOCK_SMTP_PORT=587
RELAYDOCK_SMTP_USERNAME=
RELAYDOCK_SMTP_PASSWORD=
RELAYDOCK_SMTP_TLS_MODE=starttls

# Initial administrator bootstrap. There is deliberately no usable default.
# The password is hashed into PostgreSQL; changing this value later does not
# rotate an existing account. Keep runtime environment files tightly scoped.
RELAYDOCK_ADMIN_EMAIL=admin@example.invalid
RELAYDOCK_ADMIN_PASSWORD=CHANGE_ME_LONG_UNIQUE_ADMIN_PASSWORD
RELAYDOCK_ADMIN_DISPLAY_NAME=RelayDock Administrator

# Provider base URLs are control-plane records. OpenAI, DeepSeek, and OpenRouter
# are seeded with their official OpenAI-compatible base URLs. Runtime Compose
# uses real administrator-supplied API credentials only. The values below are
# accepted solely by the isolated deterministic mock-openai test profile.
MOCK_OPENAI_API_KEY=mock-upstream-key
MOCK_WEBHOOK_SECRET=mock-webhook-secret-2026
MOCK_TEST_TOKEN=relaydock-test-control

# Browser origins are explicit; do not use * with authenticated endpoints.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Comma-separated proxy IPs/CIDRs allowed to supply X-Forwarded-For.
TRUSTED_PROXIES=

# Logging and safety
LOG_LEVEL=info
LOG_PROMPT_CONTENT=false
LOG_DIR=/app/logs
RELAYDOCK_OTEL_EXPORTER_OTLP_ENDPOINT=
RELAYDOCK_OTEL_EXPORTER_OTLP_INSECURE=false
MAX_REQUEST_BODY_BYTES=10485760
RELAYDOCK_STREAM_MAX_BYTES=67108864
# Include only reviewed upstreams. pro.muyuai.top is the optional
# gptGrok2api OpenAI-compatible bridge used by the integration probe.
RELAYDOCK_PROVIDER_ALLOWED_HOSTS=api.openai.com,api.deepseek.com,openrouter.ai,api.anthropic.com,generativelanguage.googleapis.com,open.bigmodel.cn,api.moonshot.cn,dashscope.aliyuncs.com,pro.muyuai.top
RELAYDOCK_PROVIDER_ALLOW_PRIVATE_NETWORK=false
RELAYDOCK_PROVIDER_ALLOW_HTTP=false
RELAYDOCK_MIGRATION_MODE=startup
RELAYDOCK_DRAIN_DELAY=5s
CREDENTIAL_COOLDOWN=30s
RELAYDOCK_PROVIDER_TIMEOUT=10m
# Set to the actual egress location of this replica (for example CN or SG).
# Empty disables scheduled Provider probes; it never guesses a region.
RELAYDOCK_PROVIDER_QUALITY_PROBE_REGION=
RELAYDOCK_PROVIDER_QUALITY_POLL_INTERVAL=30s
RELAYDOCK_PROVIDER_QUALITY_LEASE=2m
RELAYDOCK_PROVIDER_QUALITY_BATCH_SIZE=20
# Durable Provider account/project Provisioner. The local mock is acceptance-
# test only and is disabled by default. OpenAI mode creates documented API
# Platform projects/service accounts; it does not claim a project credit API.
RELAYDOCK_PROVIDER_PROVISIONING_POLL_INTERVAL=5s
RELAYDOCK_PROVIDER_PROVISIONING_LEASE=2m
RELAYDOCK_PROVIDER_PROVISIONING_BATCH_SIZE=20
RELAYDOCK_PROVIDER_PROVISIONING_MOCK_ENABLED=false
RELAYDOCK_OPENAI_PROVISIONING_ENABLED=false
OPENAI_ADMIN_KEY=
RELAYDOCK_SUPPLIER_SETTLEMENT_POLL_INTERVAL=1m
RELAYDOCK_SUPPLIER_SETTLEMENT_BATCH_SIZE=100
RELAYDOCK_PAYOUT_ALLOWED_REGIONS=US,CN
RELAYDOCK_PAYOUT_SANDBOX_ENABLED=false
RELAYDOCK_PAYOUT_SANDBOX_SECRET=CHANGE_ME_PAYOUT_SANDBOX_SECRET_AT_LEAST_32_BYTES
RELAYDOCK_FUNDING_RECOVERY_INTERVAL=30s
RELAYDOCK_FUNDING_STALE_AFTER=15m
# Payment channels are disabled by default. Sandbox is test-only and requires
# an injected secret of at least 32 bytes. Manual transfer requires an
# administrator evidence review; bank/payment credentials never belong here.
RELAYDOCK_PAYMENT_ORDER_TTL=30m
RELAYDOCK_PAYMENT_POLL_INTERVAL=10s
RELAYDOCK_PAYMENT_WEBHOOK_TIMESTAMP_SKEW=5m
RELAYDOCK_PAYMENT_ALLOWED_REGIONS=CN
RELAYDOCK_PAYMENT_SANDBOX_ENABLED=false
RELAYDOCK_PAYMENT_SANDBOX_SECRET=CHANGE_ME_PAYMENT_SANDBOX_SECRET_AT_LEAST_32_BYTES
RELAYDOCK_PAYMENT_MANUAL_ENABLED=false
# Subscription lifecycle polling is database-idempotent and safe across replicas.
RELAYDOCK_SUBSCRIPTION_POLL_INTERVAL=1m
RELAYDOCK_RECONCILIATION_INTERVAL=15m
RELAYDOCK_RECONCILIATION_RUN_AT=02:00
SHUTDOWN_TIMEOUT=30s
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_ALLOW_PRIVATE_NETWORK=false
WEBHOOK_TIMEOUT=10s
WEBHOOK_POLL_INTERVAL=2s
WEBHOOK_MAX_ATTEMPTS=6

# Optional read-only Cockpit integration. Generate the sanitized snapshot with
# scripts/sync-cockpit.ps1. Never mount Cockpit's OAuth/account directory.
COCKPIT_SNAPSHOT_PATH=/app/cockpit/accounts.json
COCKPIT_BASE_URL=http://host.docker.internal:51900
COCKPIT_API_KEY=
COCKPIT_TEST_MODEL=gpt-5.6-luna

# Optional SDK verification variables (used by tests/sdk/python)
RELAYDOCK_BASE_URL=http://localhost:8080/v1
RELAYDOCK_API_KEY=rdk_test_replace_me
RELAYDOCK_CHAT_MODEL=gpt-default
RELAYDOCK_EMBEDDING_MODEL=embedding-default
