{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yangjunjie-Lin/ModelDock/release/commercial-test-evidence.schema.json",
  "title": "ModelDock exact-commit commercial test evidence V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_level", "repository", "commit_sha", "tree_sha", "migration_version", "version",
    "workflow_run_id", "ref_type", "ref_name", "image_digests", "gateway_tested_server_digest", "build_digests",
    "security_scans", "sboms", "provenance", "candidate_tags", "candidate_tag_digests", "started_at", "completed_at", "status", "suites"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "evidence_level": { "enum": ["INTEGRATION", "RELEASE_CANDIDATE"] },
    "repository": { "const": "Yangjunjie-Lin/ModelDock" },
    "commit_sha": { "$ref": "#/$defs/commit" },
    "tree_sha": { "$ref": "#/$defs/commit" },
    "migration_version": { "type": "string", "pattern": "^[0-9]{4}_[a-z0-9_]+$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "workflow_run_id": { "type": "string", "pattern": "^(LOCAL|[1-9][0-9]{0,19})$" },
    "ref_type": { "enum": ["branch", "tag"] },
    "ref_name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "image_digests": { "$ref": "#/$defs/digests" },
    "gateway_tested_server_digest": { "$ref": "#/$defs/digest" },
    "build_digests": { "$ref": "#/$defs/digests" },
    "security_scans": { "$ref": "#/$defs/componentEvidence" },
    "sboms": { "$ref": "#/$defs/componentEvidence" },
    "provenance": { "$ref": "#/$defs/componentEvidence" },
    "candidate_tags": {
      "type": "object", "additionalProperties": false, "required": ["server", "admin", "console"],
      "properties": { "server": { "$ref": "#/$defs/tag" }, "admin": { "$ref": "#/$defs/tag" }, "console": { "$ref": "#/$defs/tag" } }
    },
    "candidate_tag_digests": { "$ref": "#/$defs/digests" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["PASS", "FAIL"] },
    "suites": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" } }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "tag": { "type": "string", "pattern": "^candidate-[1-9][0-9]{0,19}-[1-9][0-9]{0,9}$|^local-[0-9a-f]{12}$" },
    "digests": {
      "type": "object", "additionalProperties": false, "required": ["server", "admin", "console"],
      "properties": { "server": { "$ref": "#/$defs/digest" }, "admin": { "$ref": "#/$defs/digest" }, "console": { "$ref": "#/$defs/digest" } }
    },
    "componentEvidence": {
      "type": "object", "additionalProperties": false, "required": ["server", "admin", "console"],
      "properties": {
        "server": { "$ref": "#/$defs/check" }, "admin": { "$ref": "#/$defs/check" }, "console": { "$ref": "#/$defs/check" }
      }
    },
    "check": {
      "type": "object", "additionalProperties": false, "required": ["status", "image_digest", "commit"],
      "properties": {
        "status": { "enum": ["PASS", "NOT_RUN"] }, "image_digest": { "$ref": "#/$defs/digest" }, "commit": { "$ref": "#/$defs/commit" }
      }
    }
  }
}
