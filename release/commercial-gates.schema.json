{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yangjunjie-Lin/ModelDock/release/commercial-gates.schema.json",
  "title": "ModelDock immutable commercial gate catalog V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "gate_set_version", "gates"],
  "properties": {
    "schema_version": { "const": 2 },
    "repository": { "const": "Yangjunjie-Lin/ModelDock" },
    "gate_set_version": { "const": 2 },
    "gates": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/gate" }
    }
  },
  "$defs": {
    "profile": { "enum": ["COMMERCIAL_BETA", "MARKETPLACE_PRODUCTION"] },
    "gateId": {
      "enum": [
        "software_license", "legal_entity", "terms_of_service", "privacy_policy", "refund_policy",
        "payment_provider_agreement", "provider_commercial_rights", "provider_regions", "production_smtp",
        "managed_pitr_restore", "production_failover", "independent_security_assessment",
        "current_vulnerability_scan", "finance_signoff", "operations_signoff", "security_signoff", "legal_signoff",
        "supplier_kyb", "supplier_contract", "endpoint_ownership", "provider_quality_probe", "canary_traffic",
        "production_payout", "tax_and_invoice", "supplier_bill_reconciliation", "marketplace_dispute_drill",
        "payout_idempotency", "marketplace_second_admin", "supplier_exit_drill", "final_go_live"
      ]
    },
    "role": {
      "enum": ["Owner", "Legal", "Finance", "Commercial", "Security", "Operations", "IndependentTester"]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "profiles", "required_roles", "notes"],
      "properties": {
        "id": { "$ref": "#/$defs/gateId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/profile" }
        },
        "required_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/role" }
        },
        "notes": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
