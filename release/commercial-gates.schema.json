{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yangjunjie-Lin/ModelDock/release/commercial-gates.schema.json",
  "title": "ModelDock commercial release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runtime", "gates"],
  "properties": {
    "schema_version": { "const": 1 },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payment_adapter", "payout_adapter", "smtp_mode", "commercially_approved_provider_count", "production_ready_supplier_count"],
      "properties": {
        "payment_adapter": { "type": "string", "minLength": 1 },
        "payout_adapter": { "type": "string", "minLength": 1 },
        "smtp_mode": { "type": "string", "enum": ["local", "production"] },
        "commercially_approved_provider_count": { "type": "integer", "minimum": 0 },
        "production_ready_supplier_count": { "type": "integer", "minimum": 0 }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "profiles", "status", "evidence_reference", "evidence_sha256", "approved_by", "approved_at", "expires_at", "reviewed_commit", "notes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
        "title": { "type": "string", "minLength": 1 },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["COMMERCIAL_BETA", "MARKETPLACE_PRODUCTION"] }
        },
        "status": { "enum": ["BLOCKED", "APPROVED"] },
        "evidence_reference": { "type": "string" },
        "evidence_sha256": { "type": "string", "pattern": "^$|^[0-9a-f]{64}$" },
        "approved_by": { "type": "string" },
        "approved_at": { "type": "string" },
        "expires_at": { "type": "string" },
        "reviewed_commit": { "type": "string", "pattern": "^$|^[0-9a-f]{40}$" },
        "notes": { "type": "string" }
      }
    }
  }
}
