# Generated deployments live in /opt/relaydock/.env (mode 0600).
COMPOSE_PROJECT_NAME=relaydock
RELAYDOCK_IMAGE_TAG=production
RELAYDOCK_SOURCE_DIR=./src
TZ=Asia/Tokyo
API_DOMAIN=api.example.com
LETSENCRYPT_EMAIL=ops@example.com
ALLOWED_ORIGINS=https://api.example.com
TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1/32
GO_MODULE_PROXY=https://proxy.golang.org,direct

POSTGRES_DB=relaydock
POSTGRES_USER=relaydock
POSTGRES_PASSWORD=CHANGE_ME_HEX_ONLY
DATABASE_URL=postgres://relaydock:CHANGE_ME_HEX_ONLY@postgres:5432/relaydock?sslmode=disable
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2
POSTGRES_MAX_CONN_IDLE_TIME=5m
POSTGRES_MAX_CONN_LIFETIME=30m

REDIS_PASSWORD=CHANGE_ME_HEX_ONLY
REDIS_URL=redis://:CHANGE_ME_HEX_ONLY@redis:6379/0
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=2
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

RELAYDOCK_MASTER_KEY=CHANGE_ME_BASE64_32_BYTES
RELAYDOCK_API_KEY_HMAC_SECRET=CHANGE_ME_HEX_32_BYTES
RELAYDOCK_JWT_SECRET=CHANGE_ME_HEX_32_BYTES
RELAYDOCK_JWT_LIFETIME=15m
RELAYDOCK_JWT_REFRESH_LIFETIME=168h
RELAYDOCK_ADMIN_EMAIL=admin@example.com
RELAYDOCK_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
RELAYDOCK_ADMIN_DISPLAY_NAME=RelayDock Administrator

GATEWAY_DIAGNOSTIC_PORT=8080
CONTROL_PLANE_PORT=8081
ADMIN_WEB_PORT=3000
CONSOLE_WEB_PORT=3001
LOG_LEVEL=info
MAX_REQUEST_BODY_BYTES=10485760
CREDENTIAL_COOLDOWN=30s
SHUTDOWN_TIMEOUT=30s
WEBHOOK_TIMEOUT=10s
WEBHOOK_POLL_INTERVAL=2s
WEBHOOK_MAX_ATTEMPTS=6
