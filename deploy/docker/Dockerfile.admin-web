FROM node:22.22-alpine3.24@sha256:e58326d0d441090181ac150dc2078d3e2cf6a0d42e809aebba3ef5880935ffdd AS build
WORKDIR /src
COPY apps/admin-web/package*.json ./
RUN npm ci
COPY apps/admin-web/ ./
ARG VITE_API_BASE=/api/admin
ARG SOURCE_DATE_EPOCH=0
ENV VITE_API_BASE=$VITE_API_BASE
RUN npm run build && find dist -exec touch -d "@${SOURCE_DATE_EPOCH}" {} +

FROM nginx:1.31.5-alpine3.24@sha256:72ba65eb42c10344912a84ff42408db7d34f2feb642204570ab8fc5ffd29f1d3
RUN apk add --no-cache --upgrade 'libcrypto3>=3.5.8-r0' 'libssl3>=3.5.8-r0'
ARG VERSION=3.0.0-beta.4
ARG COMMIT=unknown
ARG BUILD_DATE=unknown
ARG REPOSITORY_URL=https://github.com/Yangjunjie-Lin/ModelDock
LABEL org.opencontainers.image.title="ModelDock Admin Web" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.source="${REPOSITORY_URL}"
COPY deploy/nginx/spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build --chown=101:101 /src/dist /usr/share/nginx/html
USER 101:101
EXPOSE 8080
