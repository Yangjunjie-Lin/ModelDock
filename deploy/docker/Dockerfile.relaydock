FROM golang:1.24-alpine AS build
WORKDIR /src
RUN apk add --no-cache ca-certificates git
COPY go.mod go.sum ./
ARG GOPROXY=https://proxy.golang.org,direct
RUN GOPROXY=${GOPROXY} go mod download
COPY internal/ ./internal/
COPY migrations/ ./migrations/
COPY cmd/relayedock/main.go ./appcmd/relayedock/main.go
COPY tests/backend/ ./tests/backend/
RUN mkdir -p /src/build \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /src/build/relaydock ./appcmd/relayedock

FROM build AS test
RUN go test -timeout 60s ./...

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S -g 10001 relaydock \
    && adduser -S -D -H -u 10001 -G relaydock relaydock \
    && mkdir -p /app/logs \
    && chown -R 10001:10001 /app
WORKDIR /app
COPY --from=build --chown=10001:10001 /src/build/relaydock /app/relayedock
USER 10001:10001
EXPOSE 8080 8081
ENTRYPOINT ["/app/relayedock"]
